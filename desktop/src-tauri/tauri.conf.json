{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noise Uniform Calculator",
  "version": "0.1.0",
  "identifier": "com.pixamed.uniform-cal",
  "build": {
    "beforeDevCommand": "yarn --cwd .. dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "yarn --cwd .. build:desktop:web",
    "frontendDist": "../../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noise Uniform Calculator",
        "width": 1200,
        "height": 800,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; font-src 'self' asset:; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
